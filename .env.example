# Copy to .env at repository root. Do not commit .env.
#
# モノレポ共通（全サイト・Vercel で共有）
# ローカル: このファイルを .env にコピーして記入
# Vercel: 同じキー名で Environment Variables に写す

# --- DB（Neon PostgreSQL）---
# 未設定・空のときは sites/restaurant/instance/helpsite.db（SQLite）にフォールバック
# 例: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# セッション署名（本番・Vercel では必ずランダム値に変更）
SECRET_KEY=replace-with-long-random-string

# --- デモアクセスゲート（§7.2）— 任意・ローカル用 ---
# Vercel では設定不要（VERCEL=1 でゲート自動 ON、VERCEL_URL で招待 URL 生成）
# ローカルでゲートを試すときだけ true にする
# DEMO_GATE_ENABLED=true
# DEMO_GATE_BASE_URL=http://localhost:5020

# --- DevRev PLuG（全サイト共通）---
# Without DEVREV_PLUG_APP_ID, the PLuG script is not loaded.
DEVREV_PLUG_APP_ID=

# 会話 ID 取得後、接続元 IP をユーザー入力で確定してから sync（false ならサーバ推定で即同期）
DEVREV_PLUG_PROMPT_USER_IP=true

# Web セッション記録（Session replay）
# https://devrev.ai/docs/plug/session-recording
DEVREV_PLUG_ENABLE_SESSION_RECORDING=false

# Application Access Token（任意）。設定時はログイン会員に RevUser セッショントークンを発行
# 未設定の場合は app_id のみで匿名 PLuG チャット
# 注意: Public AAT（tokentype: aat:public）では verified Contact にならない。非 Public AAT（aat）を使用すること
DEVREV_APPLICATION_ACCESS_TOKEN=

# Personal Access Token（ps_… 推奨）。conversations.update 用。AAT とは別
DEVREV_PAT=

# conversations.update が 400 bad_request のときの調整
DEVREV_CONVERSATION_UPDATE_SEND_SCHEMA_SPEC=true
DEVREV_CONVERSATION_UPDATE_TENANT_FRAGMENT=true
DEVREV_CONVERSATION_UPDATE_VALIDATE_REQUIRED_FIELDS=false
DEVREV_CONVERSATION_CUSTOM_FIELD_USER_IP=tnt__user_ip

# auth-tokens.create の rev_info（任意）。空なら送らない
DEVREV_ACCOUNT_REF=
DEVREV_WORKSPACE_REF=

# PLuG user_ref: member_id（既定 mbr:{id}）| email（verified 調査用）
# DEVREV_PLUG_USER_REF=member_id
# auth-tokens.create の requested_token_type: session | session_rev_public
# DEVREV_PLUG_REQUESTED_TOKEN_TYPE=session
# true: 登録/ログイン時の auth-tokens.create を遅延（PLuG 初回表示まで RevUser を作らない）
# DEVREV_PLUG_DEFER_SESSION_ON_AUTH=false

# 任意。GET /api/admin/user の管理者用 API キー（ps_ 形式推奨）
ADMIN_API_KEY=

# --- 将来: マルチ PLuG チャット（DevRev リリース後）---
# サイト別 app_id。未設定なら上の DEVREV_PLUG_APP_ID にフォールバック（docs/future-multi-plug.md）
# DEVREV_PLUG_APP_ID__restaurant=
# DEVREV_PLUG_APP_ID__employee=
# DEVREV_APPLICATION_ACCESS_TOKEN__restaurant=
# DEVREV_APPLICATION_ACCESS_TOKEN__employee=
